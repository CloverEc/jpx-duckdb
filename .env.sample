# J-Quants API Configuration
# Copy this file to .env and fill in your credentials

# J-Quants API Key (Required)
# Get your API key from: https://application.jpx-jquants.com/
JQUANTS_API_KEY=

# DuckDB Configuration
DUCKDB_PATH=./data/jquants.duckdb

# Performance Tuning
# Number of concurrent requests (higher = faster but more API load)
MAX_CONCURRENT_REQUESTS=10

# Logging
LOG_LEVEL=INFO

# Initial load settings
INITIAL_LOAD_YEARS=10
